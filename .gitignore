# Every data file lives in data/. The building register and its schema are the
# audit trail and are tracked; everything else there is either reproducible
# from a download or is Institute data that we do not redistribute.
data/*
!data/README.md
!data/building_register.csv
!data/register_schema.yml

# Large spatial outputs
*.gpkg
*.tif
*.tiff
*.laz
*.las
*.shp
*.shx
*.dbf
*.prj
*.cpg

# QGIS
*.qgz~
*.qgs~
.qgis2/
qgis/*.gpkg-shm
qgis/*.gpkg-wal

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# OpenDSS run output
*.dss_out
scripts/opendss_out/

# macOS
.DS_Store
